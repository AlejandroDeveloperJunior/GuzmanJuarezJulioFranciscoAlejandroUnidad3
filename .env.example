# ==========================================================
# MediConnect Pro â€” Variables de Entorno (Twelve-Factor App)
# Copia este archivo a .env y ajusta los valores en producciÃ³n
# ==========================================================

# Servidor Backend (NestJS)
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Base de Datos
# Local sin Docker (SQLite) â€” por defecto para ejecuciÃ³n inmediata:
DATABASE_URL="file:./mediconnect.db"
# ProducciÃ³n / Contenedores Docker (PostgreSQL 16):
# DATABASE_URL="postgresql://mediconnect_dev:SecurePassDev2026!@localhost:5432/mediconnect_db?schema=public"

# CachÃ© Redis (opcional en local: usa fallback Singleton en memoria)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisDevPass2026!

# Seguridad CriptogrÃ¡fica (JWT, Cookies y AES-256-GCM NOM-004)
JWT_ACCESS_SECRET=REPLACE_WITH_JWT_ACCESS_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRATION=7d
CSRF_SECRET=REPLACE_WITH_CSRF_HMAC_SECRET
ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS_KEY

# Web Services de Terceros
# Google reCAPTCHA v2 (claves de prueba oficiales para localhost)
RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET_KEY

# Pasarela Stripe (modo sandbox / adaptador)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SANDBOX_KEY
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY

# URL base Frontend (Vite)
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_SITE_KEY
